# Orimise — copy Base URL, endpoint, API key, and model names from your Orimise dashboard.
# Request body stays OpenAI-compatible: { model, messages, temperature }.
ORIMISE_API_KEY=your_orimise_api_key

# Option A — full URL to the chat/completions (or equivalent) endpoint (overrides base + path):
# ORIMISE_ENDPOINT=https://api.orimise.example/v1/chat/completions

# Option B — base URL only; the app calls {ORIMISE_BASE_URL}{ORIMISE_CHAT_PATH}
ORIMISE_BASE_URL=https://YOUR_ORIMISE_BASE_URL/v1
# If Orimise uses a path other than /chat/completions, set it (leading slash optional):
# ORIMISE_CHAT_PATH=/v1/chat/completions

# Model ids are exact strings from Orimise (examples below). Unset task vars fall back to ORIMISE_MODEL.
# Mapping: MODEL_STUDY = /api/summarize + /api/chat  |  MODEL_QUIZ = /api/quiz/generate  |  MODEL_GRADE = /api/quiz/grade
#
# Budget-ish (cheaper I/O): flash / OSS for volume; stronger only where it matters
#   ORIMISE_MODEL=gemini-3-flash
#   ORIMISE_MODEL_STUDY=gemini-3.1-pro
#   ORIMISE_MODEL_QUIZ=gemini-3-flash
#   ORIMISE_MODEL_GRADE=claude-sonnet-4-6
#
# Balanced OpenAI-heavy: gpt-5 for long reasoning; mini codex for structured quiz JSON
#   ORIMISE_MODEL=gpt-5-codex-mini
#   ORIMISE_MODEL_STUDY=gpt-5
#   ORIMISE_MODEL_QUIZ=gpt-5-codex-mini
#   ORIMISE_MODEL_GRADE=gpt-5.1
#
# Reference ids ($/1M input | output from your sheet): gpt-5.4, gpt-oss-120b-medium, gpt-5,
# gpt-5-codex, gpt-5-codex-mini, gpt-5.1, gpt-5.1-codex, gpt-5.1-codex-max, gpt-5.1-codex-mini,
# gpt-5.2, gpt-5.2-codex, gpt-5.3-codex, gemini-3-flash, claude-opus-4-6, claude-sonnet-4-20250514,
# claude-sonnet-4-5-20250929, claude-sonnet-4-6, gemini-3.1-pro
ORIMISE_MODEL=your_orimise_default_model
ORIMISE_MODEL_STUDY=
ORIMISE_MODEL_QUIZ=
ORIMISE_MODEL_GRADE=

# Supabase (Auth + JWT verification on /api/*). Create a project at https://supabase.com
# Project Settings → API: Project URL and anon public key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
#
# Google OAuth (configured in Supabase Dashboard, not in this file):
# Authentication → Providers → Google: add Client ID + Secret from Google Cloud Console.
# Authentication → URL Configuration: add redirect URL
#   http://localhost:3000/chat
#   (and your production URL + /chat). PKCE returns here after Google.
