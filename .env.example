# Orimise — copy Base URL, endpoint, API key, and model names from your Orimise dashboard.
# Request body stays OpenAI-compatible: { model, messages, temperature }.
ORIMISE_API_KEY=your_orimise_api_key

# Option A — full URL to the chat/completions (or equivalent) endpoint (overrides base + path):
# ORIMISE_ENDPOINT=https://api.orimise.example/v1/chat/completions

# Option B — base URL only; the app calls {ORIMISE_BASE_URL}{ORIMISE_CHAT_PATH}
ORIMISE_BASE_URL=https://YOUR_ORIMISE_BASE_URL/v1
# If Orimise uses a path other than /chat/completions, set it (leading slash optional):
# ORIMISE_CHAT_PATH=/v1/chat/completions

ORIMISE_MODEL=your_orimise_default_model
ORIMISE_MODEL_STUDY=
ORIMISE_MODEL_QUIZ=
ORIMISE_MODEL_GRADE=

# Supabase (Auth + JWT verification on /api/*). Create a project at https://supabase.com
# Project Settings → API: Project URL and anon public key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
#
# Google OAuth (configured in Supabase Dashboard, not in this file):
# Authentication → Providers → Google: add Client ID + Secret from Google Cloud Console.
# Authentication → URL Configuration: add redirect URL
#   http://localhost:3000/chat
#   (and your production URL + /chat). PKCE returns here after Google.
